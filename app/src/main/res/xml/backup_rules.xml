<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive database containing SMS logs and command history -->
    <exclude domain="database" path="jarvis_core_db" />
    <exclude domain="database" path="jarvis_core_db-wal" />
    <exclude domain="database" path="jarvis_core_db-shm" />
    <!-- Exclude sensitive API key and conversation transcripts -->
    <exclude domain="sharedpref" path="jarvis_gemini_prefs.xml" />
    <exclude domain="sharedpref" path="jarvis_context_memory.xml" />
    <exclude domain="sharedpref" path="jarvis_auto_call_sms_prefs.xml" />
</full-backup-content>
